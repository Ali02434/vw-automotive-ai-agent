# E-Mail-Einstellungen für den Delta-Report
# Diese Datei nach .env kopieren und echte Werte eintragen.
# Die .env wird NICHT committet.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SENDER=dein.name@example.com
EMAIL_PASSWORD=dein-app-passwort
EMAIL_RECEIVERS=empfaenger1@example.com,empfaenger2@example.com